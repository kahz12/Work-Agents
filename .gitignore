*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Entornos y empaquetado
venv/
venv313/
.venv/
build/
dist/
*.egg-info/

# Secretos y credenciales locales: nunca se versionan.
# Las plantillas sin valores reales (.env.example) sí se pueden subir.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*

# Cobertura y herramientas de test
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# Editores y sistema operativo
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Reportes del pipeline
reports/
AGENTES_WORKDIR/

