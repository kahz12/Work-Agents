# Demo image for the AGENTES SRE server (/metrics and /healthz)
FROM python:3.12-slim

WORKDIR /app
COPY pyproject.toml README.md LICENSE ./
COPY agentes ./agentes

# Install the package the way any user would, then run it as an unprivileged user.
RUN pip install --no-cache-dir . \
    && useradd --create-home --uid 10001 agentes

USER agentes
EXPOSE 9100
CMD ["agentes", "serve", "--host", "0.0.0.0", "--port", "9100"]
