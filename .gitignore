# Bytecode and tool caches
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Virtual environments and packaging output
venv/
venv313/
.venv/
build/
dist/
*.egg-info/

# Local secrets and credentials are never committed.
# Templates without real values (.env.example) may be committed.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*

# Coverage and test tooling
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# Editors and operating system files
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Pipeline reports
reports/
AGENTES_WORKDIR/

# ---------------------------------------------------------------
# Artefacts the demos write when they run (`demo <agent>`).
# The only real inputs are */fixtures/*.py, which are committed.
# ---------------------------------------------------------------
agentes/quality/.eslintrc.json
agentes/quality/.flake8
agentes/quality/pyproject.toml
agentes/quality/requirements_sample.txt
agentes/quality/results.sarif
agentes/quality/sample_code.py

agentes/devops/.github/
agentes/devops/.gitlab-ci.yml
agentes/devops/docker-compose.yml
agentes/devops/my-helm-chart/

agentes/docs/API_DOCUMENTATION.md
agentes/docs/openapi.json
agentes/docs/openapi.yaml
agentes/docs/sample_api.py
agentes/docs/swagger_ui.html

agentes/hardening/Dockerfile.hardened
agentes/hardening/my_app.service

agentes/qa/qa_adversarial_report.md
agentes/qa/qa_report.html
agentes/qa/qa_report.md
agentes/qa/sample_app.py
agentes/qa/test_sample_app.py
